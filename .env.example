# ==============================================================================
# SHREE SHYAM TOYS — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# Application Environment
APP_NAME="Shree Shyam Toys"
APP_URL="http://localhost:8000"
ENVIRONMENT="development"
DEBUG="true"

# Secret Key - MANDATORY in production (production fails fast if missing/empty)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""

# Database Configuration (Supabase PostgreSQL in production)
# In production, DATABASE_URL is strictly mandatory. SQLite is prohibited in production.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# 1. Create a project at https://console.cloud.google.com/
# 2. Configure OAuth Consent Screen (External, App Name: Shree Shyam Toys)
# 3. Create OAuth Client ID (Web Application)
# 4. Authorized Redirect URI: http://localhost:8000/auth/google/callback (local)
#    and https://<your-render-subdomain>.onrender.com/auth/google/callback (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# Administrator Authorization Allowlist
# Comma-separated list of Google email addresses permitted to access /admin
ADMIN_EMAILS=""  # MANDATORY in production: Comma-separated list of authorized Google email addresses

# Primary WhatsApp Business Number (Optional default; configurable via Admin Settings)
# International format with country code, digits only, no '+' sign (e.g. 91XXXXXXXXXX for India)
WHATSAPP_NUMBER=""

# Media Storage Provider ('local' for local dev, 'supabase' for production)
# In production, Supabase Storage is mandatory. Local disk fallback is strictly disabled.
STORAGE_BACKEND="local"
SUPABASE_STORAGE_BUCKET="product-media"
